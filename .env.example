# -----------------------------------------------------------------------------
# AFLYO - CONFIGURAÇÕES DE AMBIENTE (TEMPLATE)
# -----------------------------------------------------------------------------

# URL Pública do Aplicativo / PAINEL (OBRIGATÓRIO na Vercel para OAuth funcionar).
# DEVE ser o domínio da aplicação SaaS — NÃO o da landing page. Precisa estar na
# whitelist de Redirect URLs do Supabase Auth + Google OAuth.
# Em produção: https://app.aflyo.com.br  |  dev local: http://localhost:5173
VITE_PUBLIC_APP_URL=https://app.aflyo.com.br

# Base dos LINKS PÚBLICOS: link curto /o/<code> e vitrine /:username.
# Subdomínio dedicado (aflyo.com.br raiz é a landing). Se vazio, usa VITE_PUBLIC_APP_URL.
VITE_SHORTLINK_URL=https://go.aflyo.com.br

# Supabase (Banco de Dados, Autenticação e Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp (Evolution API)
# Deixe em branco se desejar desativar a integração e mostrar mensagens defensivas amigáveis
VITE_EVOLUTION_URL=
VITE_EVOLUTION_API_KEY=

# Cakto (SDK de checkout transparente - client_id publico, roda no browser)
VITE_CAKTO_CLIENT_ID=
