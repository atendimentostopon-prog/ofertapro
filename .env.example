# -----------------------------------------------------------------------------
# AFLYO - CONFIGURAÇÕES DE AMBIENTE (TEMPLATE)
# -----------------------------------------------------------------------------

# URL do PAINEL (dashboard, /auth/callback, /reset). Precisa estar na whitelist
# de Redirect URLs do Supabase Auth + Google OAuth.
VITE_PUBLIC_APP_URL=https://app.aflyo.com.br

# Base dos LINKS PÚBLICOS: link curto /o/<code> e vitrine /:username.
# Subdomínio dedicado (aflyo.com.br raiz é a landing). Se vazio, usa VITE_PUBLIC_APP_URL.
VITE_SHORTLINK_URL=https://go.aflyo.com.br

# Supabase (Banco de Dados, Autenticação e Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp (Evolution API)
# Deixe em branco se desejar desativar a integração e mostrar mensagens defensivas amigáveis
VITE_EVOLUTION_URL=
VITE_EVOLUTION_API_KEY=

# Stripe (Payment Processing) -- checkout hospedado, publishable key não é
# necessária no cliente. Chaves de fato vivem só nos secrets do Supabase
# (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET).
