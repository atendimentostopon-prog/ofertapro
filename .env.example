# -----------------------------------------------------------------------------
# AFLYO - CONFIGURAÇÕES DE AMBIENTE (TEMPLATE)
# -----------------------------------------------------------------------------

# URL Pública do Aplicativo (Rebranding / Vercel)
VITE_PUBLIC_APP_URL=https://www.aflyo.com.br

# Supabase (Banco de Dados, Autenticação e Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp (Evolution API)
# Deixe em branco se desejar desativar a integração e mostrar mensagens defensivas amigáveis
VITE_EVOLUTION_URL=
VITE_EVOLUTION_API_KEY=

# Stripe (Payment Processing) -- checkout hospedado, publishable key não é
# necessária no cliente. Chaves de fato vivem só nos secrets do Supabase
# (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET).
