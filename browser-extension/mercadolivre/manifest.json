{
  "manifest_version": 3,
  "name": "Aflyo — Automação Mercado Livre",
  "version": "1.0.0",
  "description": "Conecta sua sessão do Mercado Livre ao Aflyo para gerar links de afiliado automaticamente nos disparos do seu bot.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "https://zuqaccivowbzdfrpgekz.supabase.co/*"
  ]
}
